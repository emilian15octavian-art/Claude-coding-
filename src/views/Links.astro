---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { type Locale } from '../i18n/locales';
import { path } from '../i18n/routes';
import { pick, t } from '../i18n/t';
import { getBand, getLinks, getSettings } from '../lib/data';
import { withUtm } from '../lib/utm';
interface Props { lang: Locale }
const { lang } = Astro.props;
const [links, band, settings] = await Promise.all([getLinks(), getBand(), getSettings()]);
const items = links
  .filter((l) => l.data.page || l.data.url)
  .map((l) => ({
    id: l.id, icon: l.data.icon, label: pick(lang, l.data.label), featured: l.data.featured,
    href: l.data.page ? path(l.data.page, lang) : withUtm(l.data.url!, settings.utm, l.id),
    external: !l.data.page,
  }));
---
<Base lang={lang} pageKey="links">
  <section class="links-page narrow">
    <svg class="logo ltr" viewBox="0 0 1224 616" width="240" height="121" aria-hidden="true" focusable="false"><use href="/logo.svg#logo" /></svg>
    <h1 class="visually-hidden">{t(lang, 'pages.links.heading')}</h1>
    <p class="tag">{pick(lang, band.tagline)}</p>
    <ul class="list" role="list">
      {items.map((i) => (
        <li><a class:list={['link', i.featured && 'featured']} href={i.href} rel={i.external ? 'noopener noreferrer' : undefined}>
          <Icon name={i.icon} size={22} /><span>{i.label}</span><Icon name="arrow" size={18} class="arrow" />
        </a></li>
      ))}
    </ul>
    <p class="muted small" translate="no">{band.hashtags.join(' ')}</p>
  </section>
</Base>
<style>
  .links-page { display: grid; justify-items: center; gap: var(--space-m); padding-block: var(--space-xl); text-align: center; max-inline-size: 34rem; }
  .logo { inline-size: min(240px, 70%); block-size: auto; color: var(--text); }
  .tag { font-weight: 900; font-size: var(--step-1); }
  .list { list-style: none; padding: 0; display: grid; gap: var(--space-s); inline-size: 100%; }
  .link {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-s);
    min-block-size: 56px; padding-inline: 1.1rem; border: 2px solid var(--primary); border-radius: 999px;
    text-decoration: none; font-weight: 800; text-align: start; transition: background-color 0.2s var(--ease);
    &:hover { background: var(--surface-2); }
    &.featured { background: var(--primary); color: var(--on-primary); }
  }
  .socials { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem; list-style: none; padding: 0; }
  .socials a { display: grid; place-items: center; inline-size: 48px; block-size: 48px; border-radius: 999px; &:hover { background: var(--surface-2); } }
  .small { font-size: var(--step--1); }
</style>
