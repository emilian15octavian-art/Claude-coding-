---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { type Locale } from '../i18n/locales';
import { path, type PageKey } from '../i18n/routes';
import { t } from '../i18n/t';
import { getPage, getSettings, isPlaceholder } from '../lib/data';
import { formatDate } from '../lib/format';
interface Props { lang: Locale; pageKey: Extract<PageKey, 'privacy' | 'cookies' | 'terms' | 'shipping'> }
const { lang, pageKey } = Astro.props;
const { entry, isFallback } = await getPage(lang, pageKey);
const settings = await getSettings();
// Fill legal-entity placeholders from site.json so they are edited in one place
const { Content } = await render(entry);
const le = settings.legalEntity;
---
<Base lang={lang} pageKey={pageKey}>
  <PageHead lang={lang} pageKey={pageKey}>
    {entry.data.updated && <p class="muted">{t(lang, 'legal.updated', { date: formatDate(lang, entry.data.updated) })}</p>}
  </PageHead>
  <div class="narrow stack-l">
    <p class="notice">
      {t(lang, 'legal.binding')}
      {lang !== 'ro' && <> <a href={path(pageKey, 'ro')} hreflang="ro" lang="ro">{t(lang, 'legal.readRomanian')}</a></>}
    </p>
    {!isPlaceholder(le.name) && <div class="entity notice">
      <p><strong>{le.name}</strong> ({le.type}) · CUI <span class="ltr">{le.cui}</span> · <span class="ltr">{le.regCom}</span></p>
      <p>{le.address}</p>
    </div>}
    {isPlaceholder(le.name) && <div class="entity notice"><p><strong translate="no">Bleeding Debts 316</strong> · Romania · <a href={path('contact', lang)}>{t(lang, 'pages.contact.nav')}</a></p></div>}
    <article class="prose" lang={isFallback ? 'en' : undefined}><Content /></article>
  </div>
</Base>
