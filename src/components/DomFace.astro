---
/** Mr. D.O.M.'s face: a black chimp with a red bandana. Blinks, raises an eyebrow, talks while typing. */
interface Props { size?: number; class?: string }
const { size = 40, class: cls = '' } = Astro.props;
---
<svg class={`dom-chimp ${cls}`} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <g class="ears">
    <circle cx="9" cy="33" r="8" fill="#151515" /><circle cx="9" cy="33" r="4.5" fill="#c08a68" />
    <circle cx="55" cy="33" r="8" fill="#151515" /><circle cx="55" cy="33" r="4.5" fill="#c08a68" />
  </g>
  <ellipse cx="32" cy="32" rx="23" ry="22" fill="#151515" />
  <!-- bandana -->
  <path d="M10 22 Q32 2 54 22 Q32 15 10 22 Z" fill="#d62839" />
  <circle cx="22" cy="14.5" r="1.1" fill="#fff" /><circle cx="32" cy="11.5" r="1.1" fill="#fff" /><circle cx="42" cy="14.5" r="1.1" fill="#fff" />
  <path d="M53 21 l7 -3 l-2 6 z" fill="#d62839" />
  <!-- face -->
  <path d="M32 21 C24 19 15 22 16 31 C16.5 36 19 37 19 40 C19 49 25 54 32 54 C39 54 45 49 45 40 C45 37 47.5 36 48 31 C49 22 40 19 32 21 Z" fill="#d9a47c" />
  <!-- brows: the right one is raised (cheeky) -->
  <path class="brow-l" d="M18.5 24.5 Q25 21 30 24.5" stroke="#151515" stroke-width="2.6" fill="none" stroke-linecap="round" />
  <path class="brow-r" d="M34 23 Q40 18.5 46 22" stroke="#151515" stroke-width="2.6" fill="none" stroke-linecap="round" />
  <!-- eyes -->
  <g class="eyes">
    <ellipse cx="25" cy="30" rx="4.6" ry="5" fill="#fff" /><ellipse cx="39.5" cy="29.5" rx="4.6" ry="5.4" fill="#fff" />
    <circle class="pupil" cx="26" cy="30.5" r="2.6" fill="#24140b" /><circle class="pupil" cx="40.5" cy="30" r="2.6" fill="#24140b" />
    <circle cx="27" cy="29.3" r="0.9" fill="#fff" /><circle cx="41.5" cy="28.8" r="0.9" fill="#fff" />
  </g>
  <g class="lids" fill="#d9a47c">
    <ellipse cx="25" cy="30" rx="5" ry="5.4" /><ellipse cx="39.5" cy="29.5" rx="5" ry="5.8" />
  </g>
  <!-- slim shades (gold frame, dark lenses) -->
  <g class="shades">
    <path d="M17 24.8 H31.4 Q31.2 34.4 25.4 34.8 Q18 35 17 24.8 Z" fill="#111" opacity="0.94" />
    <path d="M33.6 24.6 H48 Q47 34.6 39.4 34.6 Q33.8 34.2 33.6 24.6 Z" fill="#111" opacity="0.94" />
    <path d="M16.4 24.8 H31.8 M33.2 24.6 H48.6 M31.8 25 Q32.5 23.9 33.2 24.8 M16.4 24.8 L11.5 23.6 M48.6 24.6 L53.5 23.4" stroke="#d4a937" stroke-width="1.1" fill="none" stroke-linecap="round" />
    <path d="M19.5 27 L23.5 27 M36.3 26.8 L40.3 26.8" stroke="#fff" stroke-width="0.9" stroke-linecap="round" opacity="0.7" />
  </g>
  <!-- nose -->
  <ellipse cx="29.6" cy="38" rx="1.3" ry="0.9" fill="#5a3522" /><ellipse cx="34.4" cy="38" rx="1.3" ry="0.9" fill="#5a3522" />
  <!-- mouth: big grin -->
  <g class="mouth">
    <path d="M22 42 Q32 52.5 42 42 Q32 45.5 22 42 Z" fill="#3a1d12" />
    <path d="M23.5 42.6 Q32 45.4 40.5 42.6 L40 44 Q32 46.3 24 44 Z" fill="#fff" />
    <path d="M27.5 48 Q32 50.5 36.5 48 Q32 46.8 27.5 48 Z" fill="#e5737f" />
  </g>
</svg>

<style>
  .dom-chimp { display: block; overflow: visible; }
  .lids { transform-box: fill-box; transform-origin: center top; transform: scaleY(0); animation: dom-blink 5.5s infinite; }
  .brow-r { transform-box: fill-box; transform-origin: center; animation: dom-brow 7s infinite; }
  .mouth { transform-box: fill-box; transform-origin: center top; }
  :global(.dom-talking) .mouth { animation: dom-talk 0.35s infinite alternate; }
  :global(.dom-open:hover) .dom-chimp, :global(.dom-open:focus-visible) .dom-chimp { animation: dom-wiggle 0.6s ease-in-out; }
  @keyframes dom-blink { 0%, 92%, 100% { transform: scaleY(0); } 95% { transform: scaleY(1); } }
  @keyframes dom-brow { 0%, 80%, 100% { transform: translateY(0); } 85%, 92% { transform: translateY(-2px) rotate(-6deg); } }
  @keyframes dom-talk { from { transform: scaleY(1); } to { transform: scaleY(0.55); } }
  @keyframes dom-wiggle { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-12deg); } 60% { transform: rotate(10deg); } }
  @media (prefers-reduced-motion: reduce) { .lids, .brow-r, :global(.dom-talking) .mouth, .dom-chimp { animation: none !important; } }
</style>
