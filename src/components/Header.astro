---
import { type Locale } from '../i18n/locales';
import { path, type PageKey } from '../i18n/routes';
import { t } from '../i18n/t';
import Icon from './Icon.astro';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props { lang: Locale; pageKey: PageKey; alternates: Record<Locale, string> }
const { lang, pageKey, alternates } = Astro.props;
const nav: PageKey[] = ['music', 'videos', 'shows', 'shop', 'about', 'gallery', 'press', 'contact'];
const items = nav.map((k) => ({ key: k, href: path(k, lang), label: t(lang, `pages.${k}.nav`) }));
---
<header class="site-header" data-site-header>
  <div class="container bar">
    <a class="brand" href={path('home', lang)} aria-label={`Bleeding Debts 316: ${t(lang, 'pages.home.nav')}`}>
      <svg class="logo ltr" viewBox="0 0 1224 616" width="96" height="48" aria-hidden="true" focusable="false"><use href="/logo.svg#logo" /></svg>
    </a>
    <nav class="nav-desktop" aria-label={t(lang, 'ui.mainNav')}>
      <ul role="list">
        {items.map((i) => <li><a href={i.href} aria-current={i.key === pageKey ? 'page' : undefined}>{i.label}</a></li>)}
      </ul>
    </nav>
    <div class="tools">
      <LangSwitcher lang={lang} alternates={alternates} />
      <ThemeToggle lang={lang} />
      <button type="button" class="menu-btn" popovertarget="site-menu" aria-controls="site-menu">
        <Icon name="menu" size={24} />
        <span class="visually-hidden">{t(lang, 'ui.menu')}</span>
      </button>
    </div>
  </div>
  <div id="site-menu" popover class="menu-panel">
    <button type="button" class="menu-close" popovertarget="site-menu" popovertargetaction="hide">
      <Icon name="close" size={24} />
      <span class="visually-hidden">{t(lang, 'ui.closeMenu')}</span>
    </button>
    <nav aria-label={t(lang, 'ui.mainNav')}>
      <ul role="list">
        <li><a href={path('home', lang)} aria-current={pageKey === 'home' ? 'page' : undefined}>{t(lang, 'pages.home.nav')}</a></li>
        {items.map((i) => <li><a href={i.href} aria-current={i.key === pageKey ? 'page' : undefined}>{i.label}</a></li>)}
        <li><a href={path('newsletter', lang)} aria-current={pageKey === 'newsletter' ? 'page' : undefined}>{t(lang, 'pages.newsletter.nav')}</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; inset-block-start: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--border);
    transition: translate 0.3s var(--ease);
    &[data-hidden] { translate: 0 -100%; }
  }
  .bar { display: flex; align-items: center; gap: var(--space-m); min-block-size: var(--header-h); }
  .brand { display: flex; align-items: center; min-block-size: 44px; color: var(--text); flex: none; }
  .logo { inline-size: 96px; block-size: auto; }
  .nav-desktop { display: none; margin-inline-start: auto; }
  .nav-desktop ul { display: flex; gap: 0.15rem; list-style: none; padding: 0; }
  .nav-desktop a, .menu-panel a {
    display: flex; align-items: center; min-block-size: 44px; padding-inline: 0.7rem; border-radius: 999px;
    text-decoration: none; font-weight: 800; font-size: var(--step--1); white-space: nowrap;
    &:hover { background: var(--surface-2); }
    &[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 0.4em; }
  }
  .tools { display: flex; align-items: center; gap: 0.25rem; margin-inline-start: auto; }
  .menu-btn, .menu-close { display: grid; place-items: center; inline-size: 44px; block-size: 44px; border: 0; border-radius: 999px; background: transparent; cursor: pointer; &:hover { background: var(--surface-2); } }

  .menu-panel {
    inset: 0 0 0 auto; margin: 0; inline-size: min(22rem, 100vw); block-size: 100dvh; max-block-size: none;
    padding: var(--space-m); border: 0; border-inline-start: 1px solid var(--border);
    background: var(--bg); color: var(--text); overflow-y: auto;
    &::backdrop { background: rgb(0 0 0 / 0.6); }
    & ul { list-style: none; padding: 0; display: grid; gap: 0.25rem; margin-block-start: var(--space-m); }
    & a { font-size: var(--step-1); }
  }
  :global([dir='rtl']) .menu-panel { inset: 0 auto 0 0; }
  .menu-close { margin-inline-start: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .menu-panel { --from: 100%; transition: translate 0.25s var(--ease), display 0.25s allow-discrete, overlay 0.25s allow-discrete; translate: 0 0; }
    :global([dir='rtl']) .menu-panel { --from: -100%; }
    @starting-style { .menu-panel:popover-open { translate: var(--from) 0; } }
  }

  @media (min-width: 80rem) {
    .nav-desktop { display: block; }
    .tools { margin-inline-start: 0; }
    .menu-btn { display: none; }
  }
</style>

<script>
  // Hide the header when scrolling down, show it when scrolling up.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  let last = scrollY;
  let ticking = false;
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const y = scrollY;
      const within = header?.contains(document.activeElement);
      if (y > last && y > 120 && !within) header?.setAttribute('data-hidden', '');
      else header?.removeAttribute('data-hidden');
      last = y;
      ticking = false;
    });
  }, { passive: true });
  header?.addEventListener('focusin', () => header.removeAttribute('data-hidden'));

  // Close the language menu with Escape or a click outside it.
  document.querySelectorAll<HTMLDetailsElement>('details[data-close-outside]').forEach((d) => {
    document.addEventListener('click', (e) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
    d.addEventListener('keydown', (e) => { if (e.key === 'Escape' && d.open) { d.open = false; d.querySelector('summary')?.focus(); } });
  });
</script>
