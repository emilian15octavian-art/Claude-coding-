---
/** Share button: the phone's own share menu (WhatsApp, Instagram, Messages…) where available, otherwise copies the link. */
import { type Locale } from '../i18n/locales';
import { t } from '../i18n/t';
interface Props { lang: Locale; title: string; url: string }
const { lang, title, url } = Astro.props;
---
<button type="button" class="btn btn-small share" data-share data-title={title} data-url={url} data-copied={t(lang, 'ui.linkCopied')}>
  <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>
  <span data-share-label>{t(lang, 'ui.share')}</span>
</button>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((b) => b.addEventListener('click', async () => {
    const { title, url, copied } = b.dataset;
    try {
      if (navigator.share) { await navigator.share({ title, url }); return; }
      await navigator.clipboard.writeText(url!);
      const label = b.querySelector('[data-share-label]')!;
      const old = label.textContent;
      label.textContent = `✓ ${copied}`;
      setTimeout(() => { label.textContent = old; }, 2500);
    } catch { /* the visitor closed the share menu */ }
  }));
</script>
