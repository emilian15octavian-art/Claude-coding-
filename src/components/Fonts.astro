---
/**
 * Self-hosted fonts (SIL Open Font License), loaded per script:
 * only the files a language needs are declared and preloaded. No Google CDN.
 */
import { localeInfo, type Locale } from '../i18n/locales';
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import nunitoLatinExt from '@fontsource-variable/nunito/files/nunito-latin-ext-wght-normal.woff2?url';
import nunitoCyrillic from '@fontsource-variable/nunito/files/nunito-cyrillic-wght-normal.woff2?url';
import notoGreek from '@fontsource-variable/noto-sans/files/noto-sans-greek-wght-normal.woff2?url';
// Arabic: small files with only the letters Arabic text needs (scripts/tools/subset-arabic.mjs)
import arabic400 from '../assets/fonts/noto-sans-arabic-core-400.woff2?url';
import arabic700 from '../assets/fonts/noto-sans-arabic-core-700.woff2?url';

interface Props { lang: Locale }
const { lang } = Astro.props;
const scripts = localeInfo[lang].scripts;

const R = {
  latin: 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD',
  latinExt: 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF',
  cyrillic: 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116',
  greek: 'U+0370-0377,U+037A-037F,U+0384-038A,U+038C,U+038E-03A1,U+03A3-03FF',
  arabic: 'U+0600-065F,U+0660-066D,U+0670-0671,U+067E,U+0686,U+06A4,U+06AF,U+06CC,U+200C-200F',
};
const face = (family: string, src: string, range: string, weight = '200 1000') =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${src}) format('woff2');unicode-range:${range}}`;

const faces = [face('Nunito Variable', nunitoLatin, R.latin), face('Nunito Variable', nunitoLatinExt, R.latinExt)];
const preload: string[] = [];
if (scripts.includes('latin')) preload.push(nunitoLatin);
if (scripts.includes('latin-ext')) preload.push(nunitoLatinExt);
if (scripts.includes('cyrillic')) { faces.push(face('Nunito Variable', nunitoCyrillic, R.cyrillic)); preload.push(nunitoCyrillic); }
if (scripts.includes('greek')) { faces.push(face('Noto Sans Variable', notoGreek, R.greek, '100 900')); preload.push(notoGreek); }
if (scripts.includes('arabic')) {
  faces.push(face('Noto Sans Arabic', arabic400, R.arabic, '400'), face('Noto Sans Arabic', arabic700, R.arabic, '700'));
  // Arabic pages: preload both Arabic weights (headings use 700, text 400); Latin loads on demand.
  preload.splice(0, preload.length, arabic700, arabic400);
}
---
{preload.slice(0, 2).map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={faces.join('')}></style>
