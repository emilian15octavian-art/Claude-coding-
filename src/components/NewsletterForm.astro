---
/**
 * Newsletter sign-up as a plain HTML form (no third-party script, no cookies). Two modes:
 *  1. Brevo (preferred later): set services.brevoFormAction in site.json. Brevo sends the
 *     double opt-in confirmation e-mail and stores the list in the EU.
 *  2. Until then: if a Web3Forms access key is set, each sign-up is e-mailed to the band's inbox.
 */
import { type Locale } from '../i18n/locales';
import { path } from '../i18n/routes';
import { t } from '../i18n/t';
import { getSettings } from '../lib/data';
interface Props { lang: Locale; id?: string; compact?: boolean }
const { lang, id = 'nl', compact = false } = Astro.props;
const { services } = await getSettings();
const brevo = services.brevoFormAction;
const key = brevo ? null : services.web3formsAccessKey;
const action = brevo ?? (key ? 'https://api.web3forms.com/submit' : null);
const site = (Astro.site?.toString() ?? '').replace(/\/$/, '');
---
<form class:list={['nl', compact && 'compact']} method="post" action={action ?? undefined} data-newsletter={key ? '' : undefined}
  data-msg-success={t(lang, 'newsletter.success')} data-msg-error={t(lang, 'newsletter.error')}>
  <div class="row">
    <div class="field grow">
      <label for={`${id}-email`}>{t(lang, 'newsletter.emailLabel')}</label>
      <input class="input ltr" id={`${id}-email`} type="email" name={key ? 'email' : 'EMAIL'} autocomplete="email" required inputmode="email" />
    </div>
    <button class="btn btn-primary" type="submit" disabled={!action}>{t(lang, 'newsletter.submit')}</button>
  </div>
  <div class="check">
    <input id={`${id}-optin`} type="checkbox" name={key ? 'consent' : 'OPT_IN'} value={key ? 'yes' : '1'} required />
    <label for={`${id}-optin`}>{t(lang, key ? 'newsletter.consentSimple' : 'newsletter.consent')}</label>
  </div>
  {key ? (
    <>
      <input type="hidden" name="access_key" value={key} />
      <input type="hidden" name="subject" value={`Newsletter sign-up (${lang})`} />
      <input type="hidden" name="from_name" value="Bleeding Debts 316 website" />
      <input type="hidden" name="language" value={lang} />
      <input type="hidden" name="redirect" value={`${site}${path('newsletter', lang)}?subscribed=1`} />
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" aria-hidden="true" />
    </>
  ) : (
    <>
      <input class="hp" type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="locale" value={lang} />
      <input type="hidden" name="html_type" value="simple" />
    </>
  )}
  <p class="muted small">
    {t(lang, key ? 'newsletter.privacySimple' : 'newsletter.privacy')} <a href={path('privacy', lang)}>{t(lang, 'pages.privacy.nav')}</a>
  </p>
  {!action && <p class="muted small" role="note">{t(lang, 'ui.comingSoon')}</p>}
  <p class="status" role="status" aria-live="polite" data-nl-status></p>
</form>

<style>
  .nl { display: grid; gap: var(--space-m); max-inline-size: 40rem; }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-s); align-items: end; }
  .grow { flex: 1 1 16rem; }
  .small { font-size: var(--step--1); }
  .status:empty { display: none; }
  .status { padding: var(--space-m); border-radius: var(--radius); background: var(--surface-2); border-inline-start: 4px solid var(--accent); }
</style>

<script>
  // Sends in place (no page reload) and shows a thank-you message; works without JavaScript too.
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-nl-status]')!;
    if (new URLSearchParams(location.search).get('subscribed') === '1') status.textContent = form.dataset.msgSuccess!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const ok = res.ok && (await res.json()).success;
        status.textContent = ok ? form.dataset.msgSuccess! : form.dataset.msgError!;
        if (ok) form.reset();
      } catch {
        status.textContent = form.dataset.msgError!;
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
