---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { type Locale } from '../i18n/locales';
import { pick, t } from '../i18n/t';
import { formatDate, formatDuration } from '../lib/format';
import ListenButtons from './ListenButtons.astro';
import Embed from './Embed.astro';
interface Props { lang: Locale; release: CollectionEntry<'releases'>; headingLevel?: 'h2' | 'h3'; eager?: boolean; tracklist?: boolean }
const { lang, release, headingLevel: H = 'h3', eager = false, tracklist = true } = Astro.props;
const d = release.data;
const alt = t(lang, 'music.coverAlt', { title: d.title });
---
<article class="release" id={release.id}>
  <Picture src={d.cover} alt={alt} formats={['avif', 'webp']} widths={[320, 480, 720, 960]} sizes="(min-width: 48rem) 22rem, 100vw"
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} class="cover" />
  <div class="info stack">
    <p class="meta muted"><span class="badge badge-neutral">{t(lang, `music.type.${d.type}`)}</span> {t(lang, 'music.released')} <time datetime={d.date}>{formatDate(lang, d.date)}</time></p>
    <H class="title" translate="no">{d.title}</H>
    {d.description && <p dir="auto" lang={d.description[lang] ? undefined : 'en'}>{pick(lang, d.description)}</p>}
    <ListenButtons lang={lang} release={release} />
    {d.spotifyEmbed && <Embed lang={lang} service="Spotify" src={`https://open.spotify.com/embed/${d.spotifyEmbed}?theme=0`} title={`${d.title}: Spotify`} label={t(lang, 'music.playEmbed', { service: 'Spotify' })} />}
    {!d.spotifyEmbed && d.bandcampAlbumId && <Embed lang={lang} service="Bandcamp" src={`https://bandcamp.com/EmbeddedPlayer/album=${d.bandcampAlbumId}/size=large/bgcol=000000/linkcol=e5383b/tracklist=false/artwork=small/transparent=true/`} title={`${d.title}: Bandcamp`} label={t(lang, 'music.playEmbed', { service: 'Bandcamp' })} />}
    {tracklist && d.tracks.length > 1 && (
      <details class="tracks">
        <summary>{t(lang, 'music.tracklist')} ({d.tracks.length})</summary>
        <ol>{d.tracks.map((tr) => <li><span translate="no">{tr.title}</span>{tr.duration && <span class="muted ltr"> {formatDuration(tr.duration)}</span>}</li>)}</ol>
      </details>
    )}
  </div>
</article>
<style>
  .release { display: grid; gap: var(--space-l); container-type: inline-size; }
  @media (min-width: 48rem) { .release { grid-template-columns: minmax(14rem, 22rem) 1fr; align-items: start; } }
  .cover { inline-size: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); }
  .cover :global(img) { inline-size: 100%; block-size: auto; border-radius: var(--radius); }
  .title { font-size: var(--step-3); }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5ch; align-items: center; font-size: var(--step--1); }
  .tracks summary { cursor: pointer; font-weight: 800; min-block-size: 44px; display: flex; align-items: center; }
  .tracks ol { padding-inline-start: 1.5em; }
</style>
