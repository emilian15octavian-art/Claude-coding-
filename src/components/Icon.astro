---
/**
 * Inline SVG icons. Brand icons come from Simple Icons (CC0) and are inlined at build time:
 * no icon font, no requests. Icons marked `directional` flip in right-to-left languages.
 */
import * as si from 'simple-icons';

interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 24, class: cls = '', label } = Astro.props;

const brands: Record<string, string> = {
  spotify: si.siSpotify.path, appleMusic: si.siApplemusic.path, youtube: si.siYoutube.path, youtubeMusic: si.siYoutubemusic.path,
  instagram: si.siInstagram.path, facebook: si.siFacebook.path, tiktok: si.siTiktok.path, bandcamp: si.siBandcamp.path,
  linktree: si.siLinktree.path, soundcloud: si.siSoundcloud.path, x: si.siX.path, threads: si.siThreads.path,
  deezer: si.siDeezer.path, tidal: si.siTidal.path,
};
// Simple outline icons (24×24, stroke based)
const ui: Record<string, string> = {
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  moon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  chevronLeft: '<path d="M15 5l-7 7 7 7"/>',
  chevronRight: '<path d="M9 5l7 7-7 7"/>',
  ticket: '<path d="M3 8a2 2 0 0 0 2-2h14a2 2 0 0 0 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 0-2 2H5a2 2 0 0 0-2-2v-2a2 2 0 0 0 0-4z"/><path d="M14 6v12" stroke-dasharray="2 2"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  cart: '<circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.5 12h11.5l2-8H6.2"/>',
  shop: '<path d="M4 8h16l-1 12H5z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  play: '<path d="M8 5v14l11-7z" fill="currentColor"/>',
  download: '<path d="M12 3v12M6 11l6 6 6-6M4 21h16"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
  shows: '<path d="M9 18V6l11-2v12"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
  newsletter: '<path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6"/>',
  pin: '<path d="M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
};
const directional = new Set(['arrow', 'chevronLeft', 'chevronRight', 'external']);
const isBrand = name in brands;
const a11y: Record<string, string> = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' };
---
{isBrand ? (
  <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={cls} {...a11y}><path d={brands[name]} /></svg>
) : (
  <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class:list={[cls, directional.has(name) && 'flip-rtl']} {...a11y} set:html={ui[name] ?? ui.link} />
)}
