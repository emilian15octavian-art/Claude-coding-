---
/**
 * ANPC badge required for Romanian online sellers (Ordinul ANPC nr. 449/2022).
 * The SOL (EU ODR platform) link is no longer shown: the EU ODR platform was closed
 * on 20 July 2025 (Regulation (EU) 2024/3228).
 * TODO before launch: replace this text badge with the official SAL pictogram from anpc.ro
 * (download it, put it in public/anpc/ and add an <img> inside the link).
 */
import { type Locale } from '../i18n/locales';
import { t } from '../i18n/t';
interface Props { lang: Locale }
const { lang } = Astro.props;
---
<div class="anpc">
  <p class="label">{t(lang, 'footer.anpc')}</p>
  <a class="sal" href="https://anpc.ro/ce-este-sal/" rel="noopener noreferrer">
    <span class="sal-mark">ANPC</span>
    <span class="sal-text">{t(lang, 'footer.anpcSal')}</span>
  </a>
</div>

<style>
  .label { font-weight: 800; margin-block-end: var(--space-xs); }
  .sal { display: inline-flex; align-items: center; gap: 0.6rem; min-block-size: 44px; padding: 0.4rem 0.8rem 0.4rem 0.4rem; border: 2px solid var(--text); border-radius: var(--radius); text-decoration: none; max-inline-size: 18rem; }
  .sal-mark { background: var(--primary); color: var(--on-primary); font-weight: 900; padding: 0.3rem 0.5rem; border-radius: 4px; letter-spacing: 0.05em; }
  .sal-text { font-size: 0.85em; line-height: 1.3; }
</style>
