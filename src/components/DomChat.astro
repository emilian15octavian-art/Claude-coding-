---
/**
 * Mr. D.O.M. 🐒: the band's monkey assistant. A small chat window that talks to /api/dom
 * (worker/index.js → Cloudflare Workers AI, free daily allowance). Nothing is sent anywhere
 * until the visitor types a question, and conversations are not stored.
 */
import { type Locale } from '../i18n/locales';
import { path } from '../i18n/routes';
import { t } from '../i18n/t';
import DomFace from './DomFace.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
---
<div class="dom" data-dom data-lang={lang} data-error={t(lang, 'dom.error')} data-ask={t(lang, 'dom.askBand')} data-contact={path('contact', lang)}>
  <button type="button" class="dom-open" popovertarget="dom-panel" aria-controls="dom-panel">
    <span class="dom-face"><DomFace size={38} /></span>
    <span class="dom-label">{t(lang, 'dom.open')}</span>
  </button>
  <div id="dom-panel" popover class="dom-panel" role="dialog" aria-labelledby="dom-title">
    <div class="dom-head">
      <p id="dom-title" class="dom-title"><span class="dom-title-face"><DomFace size={32} /></span> {t(lang, 'dom.title')}</p>
      <button type="button" class="dom-x" popovertarget="dom-panel" popovertargetaction="hide">
        <span aria-hidden="true">✕</span><span class="visually-hidden">{t(lang, 'dom.close')}</span>
      </button>
    </div>
    <div class="dom-log" data-dom-log role="log" aria-live="polite">
      <p class="msg bot">{t(lang, 'dom.greeting')}</p>
      <div class="chips" data-chips>
        {[1, 2, 3, 4].map((n) => <button type="button" class="chip" data-chip>{t(lang, `dom.chip${n}`)}</button>)}
      </div>
    </div>
    <form class="dom-form" data-dom-form>
      <label for="dom-q" class="visually-hidden">{t(lang, 'dom.placeholder')}</label>
      <input id="dom-q" class="input" type="text" name="q" maxlength="500" autocomplete="off" placeholder={t(lang, 'dom.placeholder')} required />
      <button class="btn btn-primary" type="submit">{t(lang, 'dom.send')}</button>
    </form>
    <p class="dom-note">{t(lang, 'dom.note')} <a href={path('privacy', lang)}>{t(lang, 'pages.privacy.nav')}</a></p>
  </div>
</div>

<style>
  .dom-open {
    position: fixed; inset-block-end: 1rem; inset-inline-end: 1rem; z-index: 40;
    display: inline-flex; align-items: center; gap: 0.5rem; min-block-size: 48px; padding: 0.4rem 1rem 0.4rem 0.5rem;
    border: 2px solid var(--primary); border-radius: 999px; background: var(--bg); color: var(--text);
    font-weight: 800; cursor: pointer; box-shadow: 0 6px 20px rgb(0 0 0 / 0.35);
    &:hover { background: var(--surface-2); }
  }
  .dom-face { display: grid; place-items: center; }
  .dom-title { display: flex; align-items: center; gap: 0.5rem; }
  .dom-title-face { flex: none; }
  @media (max-width: 30rem) { .dom-label { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; } .dom-open { padding: 0.4rem; inline-size: 52px; justify-content: center; } }
  .dom-panel {
    inset: auto 1rem 1rem auto; margin: 0; inline-size: min(24rem, calc(100vw - 2rem)); max-block-size: min(36rem, calc(100dvh - 2rem));
    padding: 0; border: 1px solid var(--border); border-radius: calc(var(--radius) * 2);
    background: var(--bg); color: var(--text); box-shadow: 0 16px 40px rgb(0 0 0 / 0.45);
    &:popover-open { display: flex; flex-direction: column; }
  }
  :global([dir='rtl']) .dom-panel { inset: auto auto 1rem 1rem; }
  .dom-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.5rem 0.5rem 0.5rem 1rem; border-block-end: 1px solid var(--border); }
  .dom-title { font-weight: 900; font-size: var(--step--1); }
  .dom-x { display: grid; place-items: center; inline-size: 44px; block-size: 44px; border: 0; border-radius: 999px; background: transparent; cursor: pointer; &:hover { background: var(--surface-2); } }
  .dom-log { flex: 1; overflow-y: auto; padding: 1rem; display: grid; gap: 0.6rem; align-content: start; min-block-size: 12rem; }
  .msg { max-inline-size: 85%; padding: 0.55rem 0.8rem; border-radius: 1rem; white-space: pre-wrap; overflow-wrap: anywhere; font-size: var(--step--1); }
  .msg.bot { background: var(--surface-2); justify-self: start; border-end-start-radius: 0.25rem; }
  .msg.me { background: var(--primary); color: var(--on-primary); justify-self: end; border-end-end-radius: 0.25rem; }
  .msg.typing { opacity: 0.7; }
  .msg :global(a) { color: inherit; text-decoration: underline; overflow-wrap: anywhere; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { min-block-size: 44px; padding: 0.35rem 0.8rem; border: 1px solid var(--primary); border-radius: 999px; background: transparent; color: var(--text); font: inherit; font-size: var(--step--1); cursor: pointer; &:hover { background: var(--surface-2); } }
  .ask { display: inline-flex; align-items: center; min-block-size: 44px; justify-self: start; font-size: var(--step--1); font-weight: 700; }
  .dom-form { display: flex; gap: 0.5rem; padding: 0.75rem; border-block-start: 1px solid var(--border); }
  .dom-form .input { min-inline-size: 0; flex: 1; }
  .dom-note { padding: 0 0.75rem 0.75rem; font-size: 0.75rem; color: var(--text-muted); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-dom]');
  const form = root?.querySelector<HTMLFormElement>('[data-dom-form]');
  const log = root?.querySelector<HTMLElement>('[data-dom-log]');
  type Msg = { role: 'user' | 'assistant'; content: string };
  // The conversation is kept for this tab only (sessionStorage), so it survives moving between pages.
  const KEY = 'domChat';
  let history: Msg[] = [];
  try { history = JSON.parse(sessionStorage.getItem(KEY) || '[]').filter((m: Msg) => m && typeof m.content === 'string').slice(-20); } catch { history = []; }
  const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(history.slice(-20))); } catch { /* private mode */ } };
  // Turns site paths (/en/shows/), https links and e-mail addresses in a reply into safe, clickable links.
  const LINK = /(https?:\/\/[^\s<>"')]+[^\s<>"').,!?]|\/(?:en|fr|ro|it|es|ar|ru|el)\/[a-z0-9\-/]*|[\w.+-]+@[\w-]+\.[\w.]+)/g;
  const fill = (el: HTMLElement, text: string) => {
    let last = 0;
    for (const m of text.matchAll(LINK)) {
      const raw = m[0];
      el.append(text.slice(last, m.index));
      const a = document.createElement('a');
      a.textContent = raw;
      if (raw.includes('@') && !raw.startsWith('http')) a.href = `mailto:${raw}`;
      else { a.href = raw; if (raw.startsWith('http')) { a.target = '_blank'; a.rel = 'noopener noreferrer'; } }
      el.append(a);
      last = (m.index ?? 0) + raw.length;
    }
    el.append(text.slice(last));
  };
  const add = (text: string, who: 'me' | 'bot', extra = '') => {
    const p = document.createElement('p');
    p.className = `msg ${who} ${extra}`.trim();
    if (who === 'bot') fill(p, text); else p.textContent = text;
    log!.append(p);
    log!.scrollTop = log!.scrollHeight;
    return p;
  };
  const askBand = (q: string) => {
    const a = document.createElement('a');
    a.className = 'ask';
    a.href = `${root!.dataset.contact}?q=${encodeURIComponent(q)}#contact-form`;
    a.textContent = `📩 ${root!.dataset.ask}`;
    log!.append(a);
    log!.scrollTop = log!.scrollHeight;
  };
  const ask = async (q: string) => {
    root!.querySelector('[data-chips]')?.remove();
    add(q, 'me');
    history.push({ role: 'user', content: q });
    save();
    const typing = add('…', 'bot', 'typing');
    root!.classList.add('dom-talking');
    try {
      const res = await fetch('/api/dom', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ lang: root!.dataset.lang, messages: history.slice(-8) }) });
      const data = await res.json();
      typing.remove();
      root!.classList.remove('dom-talking');
      const reply = String(data.reply || root!.dataset.error);
      add(reply, 'bot');
      history.push({ role: 'assistant', content: reply });
      save();
      if (data.unknown) askBand(q);
    } catch {
      typing.remove();
      root!.classList.remove('dom-talking');
      add(root!.dataset.error!, 'bot');
    }
  };
  if (history.length && log) {
    root!.querySelector('[data-chips]')?.remove();
    for (const m of history) add(m.content, m.role === 'user' ? 'me' : 'bot');
  }
  root?.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((b) => b.addEventListener('click', () => ask(b.textContent!.trim())));
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = form.querySelector<HTMLInputElement>('input')!;
    const q = input.value.trim();
    if (!q) return;
    input.value = '';
    ask(q).then(() => input.focus());
  });
</script>
