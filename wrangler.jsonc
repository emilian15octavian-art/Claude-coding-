// Cloudflare Workers config (used when the site is connected as a Worker in the Cloudflare dashboard).
// The site is fully static: Cloudflare serves the built files from dist/ (including _headers and the
// per-language 404.html pages). `build.command` makes sure the site is built before every deploy.
{
  "name": "claude-coding",
  "main": "./worker/index.js",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build" },
  // Needed by `wrangler preview`, which Cloudflare runs for pull-request preview builds.
  "previews": {},
  // Mr. D.O.M. 🐒 uses Cloudflare Workers AI (free daily allowance; on the free plan it never bills).
  "ai": { "binding": "AI" },
  // Fan wall storage (free KV). No id: Cloudflare creates the namespace automatically on the first deploy.
  "kv_namespaces": [{ "binding": "WALL" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/google*.html", "/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
